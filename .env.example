# Database: Neon pooled string for the app, direct string for migrations.
# Run `CREATE EXTENSION postgis;` on the Neon branch before the first migration.
DATABASE_URL=postgres://meridian:meridian@localhost:5432/meridian
DATABASE_URL_UNPOOLED=

# Auth (Better Auth). Generate a secret with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Images (Cloudinary signed uploads). Empty = local stub that stores files in public/uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Resend). Empty = emails are logged to the server console.
RESEND_API_KEY=
EMAIL_FROM=Meridian <hello@example.com>

# Vercel Cron sends `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=

# Map tiles: swap the provider here without code changes.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo mode: seed data, "Sample listing" tags, "Try the agent dashboard". Set to off at launch.
DEMO_MODE=on
